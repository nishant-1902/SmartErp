# Copy to .env and replace both secret placeholders before local use.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-django-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Replace the placeholder with the URL-encoded password for smarterp_app.
# Keep credentials out of Git; percent-encode reserved characters in the password.
MONGO_URI=mongodb://smarterp_app:<URL_ENCODED_PASSWORD>@localhost:27017/smarterp?replicaSet=rs0&authSource=smarterp
MONGO_DB_NAME=smarterp

# Optional integration-test connection. Use only the dedicated test account/database.
MONGO_TEST_URI=mongodb://smarterp_test_user:replace_with_url_encoded_test_password@localhost:27017/smarterp_test?replicaSet=rs0&authSource=smarterp_test
MONGO_TEST_DB_NAME=smarterp_test

# Use a separate random secret for JWT signing.
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret
JWT_ISSUER=smarterp-api
JWT_AUDIENCE=smarterp-client
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800

CORS_ALLOWED_ORIGINS=http://localhost:5173

REFRESH_COOKIE_NAME=smarterp_refresh
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_HTTPONLY=True
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PATH=/api/auth/
REFRESH_COOKIE_DOMAIN=
