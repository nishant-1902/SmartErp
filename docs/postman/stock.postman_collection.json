{
  "info": {
    "_postman_id": "2e9bd42b-4f2b-44a7-93df-207302a7533a",
    "name": "SmartERP Stock",
    "description": "Stock adjustment and movement history requests. Set base_url, access_token, and product_id first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "employee_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success - Increase stock",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('idempotency_key')) {",
              "  pm.collectionVariables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"quantity_change\": 3,\n  \"reason\": \"Postman stock count\"\n}"
        },
        "url": "{{base_url}}/stock-adjustments/"
      }
    },
    {
      "name": "Success - List movements",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/stock-movements/?page=1&page_size=20"
      }
    },
    {
      "name": "Success - Filter movement history",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/stock-movements/?product={{product_id}}&type=adjustment&page=1&page_size=20"
      }
    },
    {
      "name": "Negative - Reject reuse with different body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"quantity_change\": 4,\n  \"reason\": \"Different stock count\"\n}"
        },
        "url": "{{base_url}}/stock-adjustments/"
      }
    },
    {
      "name": "Negative - Employee cannot adjust stock",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{employee_access_token}}",
            "type": "string"
          }
        ]
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"quantity_change\": 1,\n  \"reason\": \"Permission example\"\n}"
        },
        "url": "{{base_url}}/stock-adjustments/"
      }
    }
  ]
}
