{
  "info": {
    "_postman_id": "f5012866-23bf-41dc-871c-76f93c8724ab",
    "name": "SmartERP Reports",
    "description": "Permission-checked reports. Set base_url and a role-appropriate access_token. List reports support date_from, date_to, page, and page_size.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
