{
  "info": {
    "_postman_id": "43da75a7-dc31-47c7-b276-8cf376889999",
    "name": "SmartERP Departments",
    "description": "Department API success and negative requests. Set base_url and access_token collection variables first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "department_id",
      "value": ""
    },
    {
      "key": "created_department_code",
      "value": ""
    },
    {
      "key": "employee_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success - List departments",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/departments/?page=1&page_size=20&sort_by=name&sort_order=asc"
      }
    },
    {
      "name": "Success - Create department",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('created_department_code', 'POSTMAN-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('department_id', pm.response.json().data.department.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{created_department_code}}\",\n  \"name\": \"Postman Operations\",\n  \"description\": \"Created by the Postman collection\",\n  \"manager_employee_id\": null,\n  \"is_active\": true\n}"
        },
        "url": "{{base_url}}/departments/"
      }
    },
    {
      "name": "Success - Get department",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/departments/{{department_id}}/"
      }
    },
    {
      "name": "Success - Patch department",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated by the Postman collection\"\n}"
        },
        "url": "{{base_url}}/departments/{{department_id}}/"
      }
    },
    {
      "name": "Success - List department employees",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/departments/{{department_id}}/employees/?page=1&page_size=20&sort_by=first_name&sort_order=asc"
      }
    },
    {
      "name": "Negative - Duplicate department code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{created_department_code}}\",\n  \"name\": \"A Different Name\"\n}"
        },
        "url": "{{base_url}}/departments/"
      }
    },
    {
      "name": "Negative - Invalid manager ObjectId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"POSTMAN-BAD-MANAGER\",\n  \"name\": \"Bad Manager Example\",\n  \"manager_employee_id\": \"not-an-object-id\"\n}"
        },
        "url": "{{base_url}}/departments/"
      }
    },
    {
      "name": "Negative - Invalid sort field",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/departments/?sort_by=name_search"
      }
    },
    {
      "name": "Negative - Employee role cannot write",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employee_access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"POSTMAN-FORBIDDEN\",\n  \"name\": \"Forbidden Department\"\n}"
        },
        "url": "{{base_url}}/departments/"
      }
    },
    {
      "name": "Negative - Deactivate department with active employees",
      "description": "Before sending, assign an active employee to department_id. Expected response: HTTP 409.",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        },
        "url": "{{base_url}}/departments/{{department_id}}/"
      }
    }
  ]
}
