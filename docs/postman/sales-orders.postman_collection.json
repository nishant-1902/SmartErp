{
  "info": {
    "_postman_id": "48d84062-bd9d-4c50-93f5-b89f9ca76a85",
    "name": "SmartERP Sales Orders - Part 1",
    "description": "Draft order CRUD, confirm/reserve, and cancel/release. Set base_url, access_token, customer_id, and product_id first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "employee_access_token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "sales_order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Success - List sales orders",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sales-orders/?page=1&page_size=20&status=draft"
      }
    },
    {
      "name": "Success - Create Draft order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const order = pm.response.json().data.sales_order;",
              "  pm.collectionVariables.set('sales_order_id', order.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2,\n      \"discount_percent\": \"5.00\",\n      \"tax_percent\": \"8.00\",\n      \"unit_price\": \"0.01\",\n      \"line_total\": \"0.01\"\n    }\n  ],\n  \"grand_total\": \"0.01\"\n}"
        },
        "url": "{{base_url}}/sales-orders/"
      }
    },
    {
      "name": "Success - Get sales order",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sales-orders/{{sales_order_id}}/"
      }
    },
    {
      "name": "Success - Patch Draft items",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 1,\n      \"discount_percent\": \"0.00\",\n      \"tax_percent\": \"0.00\"\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/sales-orders/{{sales_order_id}}/"
      }
    },
    {
      "name": "Success - Confirm and reserve inventory",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{base_url}}/sales-orders/{{sales_order_id}}/confirm/"
      }
    },
    {
      "name": "Success - Cancel and release reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{base_url}}/sales-orders/{{sales_order_id}}/cancel/"
      }
    },
    {
      "name": "Negative - Employee cannot confirm",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{employee_access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{base_url}}/sales-orders/{{sales_order_id}}/confirm/"
      }
    },
    {
      "name": "Negative - Invalid order ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/sales-orders/not-an-object-id/"
      }
    }
  ]
}
